apiVersion: traefik.containo.us/v1alpha1
kind: IngressRoute
metadata:
  name: esdl-drive
  namespace: {{ NAMESPACE }}
  annotations:
    ingress.kubernetes.io/ssl-redirect: "true"
spec:
  entryPoints:
    - websecure
  routes:
  - match: Host(`{{ DRIVE_DNS }}{{ DOMAIN_EXTENSION }}`)
    kind: Rule
    services:
    - name: esdl-drive
      port: 9080
  # make empty object, so that the default TLSStore puts our wildcard certificate here
  tls: {}
