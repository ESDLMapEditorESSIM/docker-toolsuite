#!/usr/bin/env bash
# secrets.sh - do not commit
#
# Copy this file to envs/<env>/secrets.sh and fill in the values.

# Private registry server and credentials (optional, only needed when using private images)
# export CI_REGISTRY_SERVER=""
# export CI_REGISTRY_USER_ESSIM=""
# export CI_REGISTRY_PASS_ESSIM=""
# export CI_REGISTRY_USER_MAPEDITOR=""
# export CI_REGISTRY_PASS_MAPEDITOR=""
# export CI_REGISTRY_USER_PANEL_SERVICE=""
# export CI_REGISTRY_PASS_PANEL_SERVICE=""
# export CI_REGISTRY_USER_DRIVE=""
# export CI_REGISTRY_PASS_DRIVE=""

# Generic toolsuite app secrets
# Used by Grafana and ESDL Drive at deploy time.
export GRAFANA_OAUTH_CLIENT_SECRET=""
export ESDL_DRIVE_KEYCLOAK_CLIENT_SECRET=""

# Postgres passwords
export POSTGRES_PASSWORD=""
export POSTGRES_BOUNDARY_SERVICE_PASSWORD=""
export POSTGRES_DRIVE_PASSWORD=""
export POSTGRES_DATA_MANAGER_PASSWORD=""
export POSTGRES_ESSIM_PASSWORD=""
export POSTGRES_MAPEDITOR_PASSWORD=""

# RabbitMQ credentials
export RABBITMQ_USER="user"
export RABBITMQ_PASSWORD=""

# MapEditor OIDC client settings. Endpoints come from IDM_BASE_URL in .env.
read -r -d '' MAPEDITOR_CLIENT_SECRETS << 'EOF' || true
{
  "web": {
    "client_id": "esdl-mapeditor",
    "client_secret": "",
    "redirect_uris": ["https://mapeditor.example.com/*"]
  }
}
EOF
export MAPEDITOR_CLIENT_SECRETS
