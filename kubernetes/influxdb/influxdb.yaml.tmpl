apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app: influxdb
  name: influxdb
  namespace: {{ NAMESPACE }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: influxdb
  template:
    metadata:
      labels:
        app: influxdb
    spec:
      containers:
      - env:
        - name: INFLUXDB_ADMIN_PASSWORD
          value: admin
        - name: INFLUXDB_ADMIN_USER
          value: admin
        - name: INFLUXDB_DB
          value: panelservice
        - name: INFLUXDB_WRITE_USER
          value: panelservice
        - name: INFLUXDB_WRITE_USER_PASSWORD
          value: panelservice
        image: influxdb:1.7
        # livenessProbe:
        #   exec:
        #     command:
        #     - curl
        #     - -f
        #     - http://influxdb:8086/ping
        #   periodSeconds: 10
        #   timeoutSeconds: 5
        name: influxdb
        resources:
          requests:
            memory: "4Gi"
        ports:
        - containerPort: 8086
        volumeMounts:
        - mountPath: /var/lib/influxdb
          name: influxdb-storage
      restartPolicy: Always
      volumes:
      - name: influxdb-storage
        persistentVolumeClaim:
          claimName: influxdb-storage
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  labels:
    app: influxdb-storage
  name: influxdb-storage
  namespace: {{ NAMESPACE }}
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 16000Mi
---
apiVersion: v1
kind: Service
metadata:
  labels:
    app: influxdb
  name: influxdb
  namespace: {{ NAMESPACE }}
spec:
  ports:
  - name: "8086"
    port: 8086
    targetPort: 8086
  selector:
    app: influxdb
status:
  loadBalancer: {}
---
apiVersion: traefik.containo.us/v1alpha1
kind: IngressRoute
metadata:
  name: influxdb
  namespace: {{ NAMESPACE }}
spec:
  entryPoints:
    - websecure
  routes:
    - match: Host(`{{ INFLUXDB_DNS }}{{ DOMAIN_EXTENSION }}`)
      kind: Rule
      services:
        - name: influxdb
          port: 8086
  # make empty object, so that the default TLSStore puts our wildcard certificate here
  tls: {}
